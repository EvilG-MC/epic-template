{
    /* from https://github.com/total-typescript/tsconfig - bundler/no-dom/app */
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        /* Base Options: */
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "es2022",
        "allowJs": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        /* Strictness */
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        /* If NOT transpiling with TypeScript: */
        "module": "preserve",
        "noEmit": true,
        /* If your code doesn't run in the DOM: */
        "lib": ["es2022"],
        "paths": {
            "#template/types": ["./src/structures/lib/types/index.ts"],
            "#template/config": ["./src/structures/util/data/Configuration.ts"],
            "#template/constants": ["./src/structures/util/data/Contants.ts"],
            "#template/client": ["./src/structures/base/Base.ts"],
            "#template/builders": ["./src/structures/lib/classes/index.ts"],
            "#template/listeners": ["./src/structures/lib/listeners/index.ts"],
            "#template/utils/*": ["./src/structures/util/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
